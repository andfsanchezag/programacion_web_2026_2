{
  "name": "banking-domain",
  "version": "1.0.0",
  "description": "Banking Information Management System - Domain Layer",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "coverage": "vitest run --coverage",
    "start": "tsx application/server.ts",
    "seed": "tsx scripts/seed-data.ts",
    "dev": "tsx watch application/server.ts"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^18.19.130",
    "@vitest/coverage-v8": "^3.2.7",
    "tsx": "^4.23.12",
    "typescript": "^4.0.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "mongoose": "^6.13.11",
    "mysql2": "^3.24.4",
    "typeorm": "^1.1.1"
  }
}
